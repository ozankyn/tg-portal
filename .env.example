# TG Portal Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin

# Güvenlik
SECRET_KEY=change-this-to-a-secure-random-string

# Veritabanı
DB_PASSWORD=tgportal123

# NetGSM SMS
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Mail
MAIL_SERVER=mail.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=portal@example.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Portal <portal@example.com>

# AI (Anthropic Claude - masraf fiş okuma, IBAN otomatik okuma)
ANTHROPIC_API_KEY=

# Upload
UPLOAD_FOLDER=/app/uploads
